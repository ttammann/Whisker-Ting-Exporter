#!/bin/sh
# Leak guard (design 13.2): what this push adds, checked once more (a commit made without the hooks).
top="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    python3 "$top/tools/overlay.py" leakcheck || status=1          # a new branch: every tracked file
  else
    python3 "$top/tools/overlay.py" leakcheck --range "$remote_sha..$local_sha" || status=1
  fi
done
exit $status
